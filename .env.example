# Dashboard access requires an account; missing diagnostics show a reminder.
# For isolated local guest testing enable the dev panel below.
PAESSED_DEV_MODE=false
# APP_ENV=local permits testing a local production build; never set on production.
APP_ENV=
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never use a NEXT_PUBLIC_ prefix for privileged credentials.
SUPABASE_SECRET_KEY=
# Use a login role inheriting paessed_server, not the migration administrator.
DATABASE_URL=
# Set the provider CA as PEM when the pooler certificate requires it.
DATABASE_SSL_CA=
AUTH_FLOW_SECRET=
# Optional locally. Enable Supabase Auth CAPTCHA before a public pilot.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# HMAC secret for trusted proxy IP identifiers; keep separate from auth flow secret.
IP_HMAC_SECRET=
# Empty for loopback development. For hosting, use vercel or cloudflare only
# when the deployment overwrites its trusted IP header and origin bypass is blocked.
TRUSTED_PROXY=
# Enable the local Google provider only after creating development OAuth credentials.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
